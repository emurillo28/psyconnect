# AWS Configuration
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_USER_POOL_ID=us-east-1_xxxxxxxx
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Feature Flags
NEXT_PUBLIC_ENABLE_AVATAR=true
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_ASSESSMENTS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Avatar Configuration
NEXT_PUBLIC_AVATAR_BASE_URL=https://your-avatar-assets-bucket.s3.amazonaws.com
NEXT_PUBLIC_AVATAR_EXPRESSIONS=["happy", "neutral", "sad", "anxious", "calm"]
NEXT_PUBLIC_AVATAR_ACCESSORIES=["glasses", "hat", "scarf", "necklace"]

# Gamification Configuration
NEXT_PUBLIC_POINTS_PER_ACTIVITY=10
NEXT_PUBLIC_POINTS_PER_LEVEL=100
NEXT_PUBLIC_MAX_LEVEL=50

# Assessment Configuration
NEXT_PUBLIC_ASSESSMENT_TYPES=["PHQ-9", "GAD-7", "PSS-10"]
NEXT_PUBLIC_ASSESSMENT_FREQUENCY=7 # days

# Notification Configuration
NEXT_PUBLIC_NOTIFICATION_TYPES=["appointment", "assessment", "achievement", "reward"]
NEXT_PUBLIC_NOTIFICATION_CHANNELS=["email", "push", "in-app"]
NEXT_PUBLIC_NOTIFICATION_PREFERENCES=["all", "important", "none"] 